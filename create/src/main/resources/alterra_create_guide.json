  "entries": [
    {
      "id": "juice_press",
      "chapter": "create",
      "title": "Pressing Juice",
      "icon": "create:mechanical_press",
      "unlock": [
        "item:alterra:mango",
        "item:alterra:peach",
        "item:alterra:pomegranate",
        "item:alterra:plum",
        "item:alterra:orange",
        "item:alterra:grapes",
        "item:alterra:white_grapes",
        "item:alterra:cherry",
        "item:alterra:coconut",
        "item:alterra:prickly_pear",
        "item:alterra:banana",
        "item:alterra:sun_apple",
        "item:alterra:sour_apple",
        "item:alterra:frost_apple",
        "item:alterra:ember_apple"
      ],
      "hint": "Pick a fruit first.",
      "pages": [
        {
          "steps": [
            {
              "in": [
                "alterra:peach",
                "alterra:peach"
              ],
              "out": "alterra_kitchen:peach_juice",
              "via": "create:mechanical_press",
              "amount": "250 mB",
              "text": "A press over a basin: two fruit make juice."
            },
            {
              "in": [
                "create:basin"
              ],
              "out": "alterra_kitchen:peach_juice",
              "via": "create:fluid_pipe",
              "text": "Pipe it from the basin into a tank."
            }
          ],
          "text": "Works with every fruit that has a juice."
        },
        {
          "text": "Any fruit with a juice can be pressed: two fruit give 250 mB, one coconut gives 250 on its own. The basin keeps the juice until a pipe or spout takes it."
        }
      ],
      "mod": "create"
    },
    {
      "id": "juice_mix",
      "chapter": "create",
      "title": "Mixing Juice",
      "icon": "create:mechanical_mixer",
      "unlock": [
        "item:alterra:mango",
        "item:alterra:peach",
        "item:alterra:pomegranate",
        "item:alterra:plum",
