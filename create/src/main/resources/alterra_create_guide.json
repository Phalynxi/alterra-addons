        "item:alterra:sun_apple",
        "item:alterra:sour_apple",
        "item:alterra:frost_apple",
        "item:alterra:ember_apple"
      ],
      "hint": "Pick a fruit first.",
      "pages": [
        {
          "steps": [
            {
              "in": [
                "alterra:orange",
                "alterra:orange",
                "minecraft:sugar",
                "minecraft:water_bucket"
              ],
              "out": "alterra_kitchen:orange_juice",
              "via": "create:mechanical_mixer",
              "amount": "500 mB",
              "text": "Fruit, sugar and 250 mB of water in a basin with a mixer: twice as much juice as pressing."
            }
          ]
        }
      ],
      "mod": "create"
    },
    {
      "id": "bottling",
      "chapter": "create",
      "title": "Bottling",
      "icon": "create:spout",
