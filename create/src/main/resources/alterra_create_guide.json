        "item:alterra:frost_apple",
        "item:alterra:ember_apple"
      ],
      "hint": "Pick a fruit first.",
      "pages": [
        {
          "text": "A basic juice line: a funnel puts fruit into a basin, a press above it presses the fruit, a pipe takes the juice to a tank, and a spout over a belt fills bottles from the tank. A funnel at the end of the belt picks them up."
        },
        {
          "steps": [
            {
              "in": [
                "alterra:mango"
              ],
              "out": "create:basin",
              "via": "create:andesite_funnel"
            },
            {
              "in": [
                "create:basin"
              ],
              "out": "alterra_kitchen:mango_juice",
              "via": "create:mechanical_press",
              "amount": "250 mB"
            },
            {
              "in": [
                "alterra_kitchen:mango_juice"
              ],
              "out": "create:fluid_tank",
              "via": "create:fluid_pipe"
            },
            {
              "in": [
                "minecraft:glass_bottle"
              ],
              "out": "alterra_kitchen:mango_juice",
              "via": "create:spout"
            }
          ]
        }
      ],
      "mod": "create"
    },
