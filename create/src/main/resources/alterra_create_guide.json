        "item:alterra:frost_apple",
        "item:alterra:ember_apple"
      ],
      "hint": "Pick a fruit first.",
      "pages": [
        {
          "steps": [
            {
              "in": [
                "minecraft:glass_bottle"
              ],
              "out": "alterra_kitchen:orange_juice",
              "via": "create:spout",
              "text": "A spout fills glass bottles on a belt or depot, 250 mB each."
            },
            {
              "in": [
                "alterra_kitchen:orange_juice"
              ],
              "out": "minecraft:glass_bottle",
              "via": "create:item_drain",
              "amount": "250 mB",
              "text": "An item drain turns them back into juice."
            }
          ]
        }
      ],
      "mod": "create"
    },
    {
      "id": "blends",
      "chapter": "create",
      "title": "Blends",
      "icon": "alterra_kitchen:tropical_punch",
      "unlock": [
        "item:alterra:mango",
        "item:alterra:orange",
        "item:alterra:banana"
      ],
      "hint": "Find mangoes, oranges or bananas.",
      "pages": [
        {
          "steps": [
            {
              "in": [
                "alterra_kitchen:mango_juice",
                "alterra_kitchen:orange_juice",
                "alterra:banana"
              ],
              "out": "alterra_kitchen:tropical_punch",
              "via": "create:mechanical_mixer",
              "amount": "500 mB",
              "text": "250 mB each of mango and orange juice, plus a banana."
            },
            {
              "in": [
                "alterra:banana",
                "alterra:banana",
                "minecraft:milk_bucket"
              ],
              "out": "alterra_kitchen:banana_smoothie",
              "via": "create:mechanical_mixer",
              "amount": "500 mB",
              "text": "Two bananas and 250 mB of milk."
            }
          ]
        }
      ],
      "mod": "create"
    },
    {
      "id": "factory",
      "chapter": "create",
      "title": "A Juice Line",
      "icon": "create:belt_connector",
      "unlock": [
        "item:alterra:mango",
